# Postgres connection string for the schema/migrations added in this slice
# (src/lib/db/). Nothing in the app reads this yet — see docs/DATABASE.md.
DATABASE_URL=postgres://user:password@localhost:5432/socialtrace

# Which SocialDataProvider implementation src/lib/providers/index.ts uses.
# "mock" (default, no cost) or "apify" (real Instagram data via Apify —
# see docs/PROVIDER_CONTRACT.md; requires APIFY_API_TOKEN and bills per use).
SOCIAL_PROVIDER=mock
APIFY_API_TOKEN=

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/capture-tracked (see vercel.json, docs/SCHEDULER.md). Unset ->
# that route refuses every request, including with no header at all.
CRON_SECRET=

# Upstash Redis REST credentials (https://upstash.com) for distributed
# rate limiting (src/lib/rate-limit.ts, docs/PRODUCTION_HARDENING.md).
# Both unset -> falls back to the original in-process limiter (fine for
# a single instance, not for multi-instance serverless deployment).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSN (https://sentry.io) for error/performance monitoring
# (sentry.*.config.ts, docs/PRODUCTION_HARDENING.md). Unset -> Sentry's
# SDK no-ops (its own documented behavior with an empty DSN), so nothing
# breaks without an account configured.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
