# Postgres connection string for the schema/migrations added in this slice
# (src/lib/db/). Nothing in the app reads this yet — see docs/DATABASE.md.
DATABASE_URL=postgres://user:password@localhost:5432/socialtrace

# Which SocialDataProvider implementation src/lib/providers/index.ts uses.
# "mock" (default, no cost) or "apify" (real Instagram data via Apify —
# see docs/PROVIDER_CONTRACT.md; requires APIFY_API_TOKEN and bills per use).
SOCIAL_PROVIDER=mock
APIFY_API_TOKEN=

# How many hours a profile lookup (src/lib/cache/profile-cache.ts) is served
# from the database before the next search re-hits the real provider.
# Only matters with DATABASE_URL set; unset -> defaults to 6.
PROFILE_CACHE_TTL_HOURS=6

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/capture-tracked (see vercel.json, docs/SCHEDULER.md). Unset ->
# that route refuses every request, including with no header at all.
CRON_SECRET=

# Upstash Redis REST credentials (https://upstash.com) for distributed
# rate limiting (src/lib/rate-limit.ts, docs/PRODUCTION_HARDENING.md).
# Both unset -> falls back to the original in-process limiter (fine for
# a single instance, not for multi-instance serverless deployment).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSN (https://sentry.io) for error/performance monitoring
# (sentry.*.config.ts, docs/PRODUCTION_HARDENING.md). Unset -> Sentry's
# SDK no-ops (its own documented behavior with an empty DSN), so nothing
# breaks without an account configured.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Search engine ownership-verification tokens (Google Search Console,
# Bing Webmaster Tools, Yandex Webmaster) — see docs/SEO.md. Each is
# rendered as its own <meta name="..." content="..."> tag only when set;
# unset -> that tag is simply omitted, same opt-in pattern as everything
# else here. Get the token value from each tool's "HTML tag" verification
# method (not the full <meta> tag, just the content value).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Ezoic display ads (see docs/ADS.md). "false"/unset -> no script loads
# and no <AdSlot> renders anywhere, same opt-in pattern as everything
# else here. NEXT_PUBLIC_* because the client-side script/placeholder
# code needs to read it in the browser.
NEXT_PUBLIC_EZOIC_ENABLED=false

# Ezoic's Ads.txt Manager redirect target for this site (Ezoic dashboard's
# "Ads.txt Setup" step gives you this exact URL, e.g.
# https://srv.adstxtmanager.com/19390/socialtrace.co — the number is your
# Ezoic account/site id). /ads.txt (src/app/ads.txt/route.ts) 301-redirects
# there so Ezoic's authorized-sellers list stays current without us
# copy-pasting a static snapshot. Unset -> that route 404s instead of
# guessing a URL.
EZOIC_ADS_TXT_URL=

# Click-to-continue ad gate (src/components/ads/ad-gate.tsx, docs/ADS.md).
# Requires NEXT_PUBLIC_EZOIC_ENABLED=true as well — this alone does
# nothing if ads themselves are off. Unset/false -> profile search
# navigates straight through with no gate, same as before this existed.
NEXT_PUBLIC_AD_GATE_ENABLED=false

# Google AdSense (see docs/ADS.md) — a parallel monetization path while
# Ezoic's Incubator review is pending. NEXT_PUBLIC_ADSENSE_CLIENT_ID
# ("ca-pub-XXXXXXXXXXXXXXXX") alone makes the verification script render
# in <head> on every page (required for Google's site-ownership review) —
# it does NOT show any ads by itself. NEXT_PUBLIC_ADSENSE_ENABLED=true is
# the separate switch that turns on actual ad rendering, only flip it once
# the site is verified/approved. Each NEXT_PUBLIC_ADSENSE_SLOT_<id> maps
# an ad unit (created in the AdSense dashboard) to one of this app's
# placement ids (100 home, 102 tools, 103 profile, 104 ad-gate) — a
# placement with no slot id set just stays empty. If NEXT_PUBLIC_EZOIC_ENABLED
# is also true, Ezoic wins every slot; the two are never shown together.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_100=
NEXT_PUBLIC_ADSENSE_SLOT_102=
NEXT_PUBLIC_ADSENSE_SLOT_103=
NEXT_PUBLIC_ADSENSE_SLOT_104=

# Paddle billing (see docs/BILLING.md) — the real payment processor behind
# users.plan (chosen over Stripe because Stripe doesn't support Turkey as
# an account country). All of these unset -> /account shows a disabled
# "coming soon" upgrade button, same opt-in pattern as everything else
# here. PADDLE_ENVIRONMENT=sandbox (default) or "production" — matches
# the sandbox/live toggle in the Paddle dashboard; keep it on sandbox
# until you're actually ready to take real payments.
# PADDLE_API_KEY: server-side, from Paddle dashboard > Developer tools >
# Authentication.
# PADDLE_PRO_PRICE_ID: the recurring Price id (starts "pri_") for the one
# Pro subscription this app sells, created under Catalog > Products.
# PADDLE_WEBHOOK_SECRET: the signing secret from the notification
# destination you create pointing at /api/v1/billing/webhook (Developer
# tools > Notifications) — required for users.plan to ever actually
# change; without it, checkout completes on Paddle's side but this app
# never finds out.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN: client-side, safe to expose in the
# browser (same dashboard page as PADDLE_API_KEY) — Paddle.js needs this
# to open the checkout overlay (docs/BILLING.md explains why Paddle's
# checkout is JS-based rather than a hosted redirect page like Stripe's).
# NEXT_PUBLIC_PADDLE_ENVIRONMENT: mirrors PADDLE_ENVIRONMENT for the
# client-side SDK — keep both in sync.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_PRO_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Video transcriber (docs/TRANSCRIBER.md) — /transcribe. Groq is the
# primary speech-to-text provider (whisper-large-v3-turbo: 9x cheaper than
# OpenAI's own endpoint, generous free tier). OPENAI_API_KEY is an
# optional fallback used only if Groq itself errors/rate-limits — unset
# means no fallback, a Groq failure just fails that request. Requires
# DATABASE_URL (the cache/quota/abuse-ceiling this feature depends on all
# live there); unset GROQ_API_KEY with no OpenAI key either -> every
# request fails with a clear "not configured" error, same opt-in pattern
# as every other integration here.
GROQ_API_KEY=
OPENAI_API_KEY=

# Cloudflare Turnstile bot protection on login/signup (docs/AUTH.md).
# Get both from the Cloudflare dashboard (Turnstile > Add site) — free.
# Either unset -> the challenge widget doesn't render and server-side
# verification always passes, same as before this existed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
