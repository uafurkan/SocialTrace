# yt-dlp-exec normally downloads the "yt-dlp" release asset, a Python
# zipapp that needs a system python3 interpreter — Vercel's Node.js
# serverless runtime has none, so that build silently can't run in
# production. This points it at "yt-dlp_linux" instead: a PyInstaller
# standalone binary with Python bundled in, no system python needed.
# Deliberately NOT overriding youtube_dl_filename here — the on-disk
# name must stay the default "yt-dlp" so downloader.ts's require of
# yt-dlp-exec resolves to the same path at runtime (env vars set for
# `npm install` don't persist into the deployed function's env), while
# its *contents* are the standalone binary fetched from this URL.
youtube_dl_host=https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux
